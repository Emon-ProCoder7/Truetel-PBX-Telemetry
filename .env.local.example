# Supabase — Project Settings > API in the Supabase dashboard.
# Server-only: this app has no browser-side Supabase usage, so nothing here
# needs a NEXT_PUBLIC_ prefix. Every query runs through server-only code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recording retention cleanup (app/api/cron/cleanup-recordings) — set in
# Vercel's env vars, not needed locally. Vercel auto-sends CRON_SECRET as a
# bearer token on its own scheduled invocations (see vercel.json).
# CRON_SECRET=
# RECORDING_RETENTION_DAYS=90
